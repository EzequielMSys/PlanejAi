
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=tcc
DB_CONNECTION_LIMIT=10
DB_MAX_IDLE=10
DB_QUEUE_LIMIT=50
DB_IDLE_TIMEOUT_MS=60000
DB_CONNECT_TIMEOUT_MS=10000
JOB_QUEUE_CONCURRENCY=2
JOB_QUEUE_MAX_PENDING=100
AUDIT_HASH_SALT=troque-por-um-valor-aleatorio

# Porta HTTP. O servidor escuta em 0.0.0.0 para acesso pela rede local.
PORT=3000

# Em produção, você pode usar uma única URL fornecida pelo serviço MySQL.
# Quando definida, DATABASE_URL substitui as opções DB_* acima.
DATABASE_URL=
# A URI do Aiven já inclui `?ssl-mode=REQUIRED` e ativa TLS automaticamente.
# Para validação completa do certificado, use DB_SSL_MODE=verify-full e cole
# a CA em DB_SSL_CA ou sua versão base64 em DB_SSL_CA_BASE64.
DB_SSL_MODE=
DB_SSL_CA=
DB_SSL_CA_BASE64=

# Insere conteúdos e questões essenciais sem duplicar registros.
AUTO_SEED_DATABASE=true

# Banco secundário usado somente pelo comando de backup lógico.
# Use credenciais diferentes do banco principal.
BACKUP_DATABASE_URL=
# Necessário para substituir tabelas que já existam no banco de backup.
BACKUP_ALLOW_REPLACE=false
BACKUP_INTERVAL_HOURS=24
BACKUP_RUN_ON_START=false

# URL pública do frontend usada nos links enviados por email.
# Em desenvolvimento, use http://localhost:5173; na Vercel, use seu domínio.
APP_URL=http://localhost:5173
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=


# Use a long, unique value outside local development.
JWT_SECRET=troque-esta-chave-por-uma-chave-longa-e-aleatoria
# Separe múltiplas origens por vírgula. Não inclua barra no final.
# Evite `*`: ele casa rótulos do host sem distinguir faixa de IP de domínio,
# então http://192.168.*.*:5173 também liberaria http://192.168.evil.com:5173.
# Em produção mantenha apenas domínios exatos e CORS_ALLOW_PRIVATE_NETWORK=false.
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173,http://SEU_IP_LOCAL:5173,https://ezequielmsys.github.io
# Aceita qualquer origem http:// em IP privado (10/8, 172.16/12, 192.168/16,
# 127/8, 169.254/16, ::1, fc00::/7, fe80::/10), em qualquer porta. Prático em
# desenvolvimento porque o roteador troca o IP do computador a cada boot.
# Deixe false em produção.
CORS_ALLOW_PRIVATE_NETWORK=false
# Defina true somente atrás de um proxy reverso confiável.
TRUST_PROXY=false
# Proteção contra força bruta e criação automatizada de contas.
LOGIN_RATE_LIMIT=8
AUTH_RATE_LIMIT=5
REGISTRATION_LIMIT=5
REGISTRATION_WINDOW_MS=1800000
REGISTRATION_CONCURRENCY_LIMIT=2
# Use 12 ou mais em produção; o sistema nunca aceita valor abaixo de 12.
BCRYPT_SALT_ROUNDS=12
# Armazenamento de anexos: em produção use um Vercel Blob privado e configure
# este token pelo painel da Vercel; nunca o exponha como VITE_*.
BLOB_READ_WRITE_TOKEN=
