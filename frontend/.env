# URL pública do backend, sem barra no final.
# Em desenvolvimento, deixe vazio para usar o proxy do Vite.
VITE_API_URL=

# Client ID público do app criado em https://developer.spotify.com/dashboard
# Redirect de produção: https://ezequielmsys.github.io/PlanejAi/
